{
  "name": "defi-recipes-keeper",
  "version": "1.0.0",
  "description": "Off-Chain Automation Keeper Engine for DeFi Recipes on Arc",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:migrate": "node scripts/run-migrations.js",
    "smoke:endpoints": "node scripts/smoke-endpoints.js",
    "verify:dca-tx": "node scripts/verify-dca-tx.js",
    "probe:dca-routes": "node scripts/probe-dca-routes.js",
    "cleanup:test-data": "node scripts/cleanup-test-data.js",
    "pipeline:smoke-cleanup": "node scripts/smoke-and-cleanup.js",
    "test": "vitest run",
    "benchmark:perf": "npm run build && node dist/benchmarks/keeperPerformanceBenchmark.js",
    "alerts:check": "npm run build && node dist/observability/monitorAlerts.js"
  },
  "dependencies": {
    "@circle-fin/app-kit": "1.8.1",
    "@lifi/sdk": "4.7.0",
    "bullmq": "^5.7.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "pg": "^8.22.0",
    "viem": "^2.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": ">=1.1.21",
      "brace-expansion@2": ">=2.0.2",
      "brace-expansion": ">=5.0.12",
      "nanoid": ">=3.3.18",
      "vite": ">=6.4.3",
      "toml": ">=4.2.0",
      "stream-json": ">=3.5.0",
      "uuid": ">=11.1.1"
    }
  }
}
